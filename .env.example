# Copiar a .env.local y completar. Solo las variables con prefijo VITE_ llegan al navegador:
# NUNCA poner aquí secretos de servidor. La configuración web de Firebase es pública por diseño.
VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
