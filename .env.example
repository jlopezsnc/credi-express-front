# Copiar a .env.local y completar. Solo las variables con prefijo NG_APP_ llegan al navegador (scripts/generar-env.mjs):
# NUNCA poner aquí secretos de servidor. La configuración web de Firebase es pública por diseño.
NG_APP_API_BASE_URL=/api
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_APP_ID=
# Logotipo del negocio para el recibo de pago (opcional). Ruta del mismo dominio, p. ej. /logo.png
# (archivo en public/). Vacío = logotipo temporal. Una URL de otro dominio la bloquea la CSP.
NG_APP_LOGO_URL=
