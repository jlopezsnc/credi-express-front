{
  "name": "credi-express-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "env": "node scripts/generar-env.mjs",
    "prestart": "npm run env",
    "start": "ng serve",
    "prebuild": "npm run env",
    "build": "ng build",
    "pretypecheck": "npm run env -- --sin-validar",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run env -- --sin-validar",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "test:e2e": "playwright test",
    "api:types": "npx --yes openapi-typescript@7.13.0 http://localhost:8080/v3/api-docs -o src/app/core/api/schema.d.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@firebase/app": "0.16.4",
    "@firebase/auth": "1.13.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  }
}
